# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root. Unanchored "lib/" matches at ANY depth, which silently
# swallowed flutter_app/lib/ - the entire Flutter application source. It has never been
# committed on any branch; the only copy is on the machine that built the APK.
# These rules exist for Python virtualenvs, which only ever appear at the root.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/

# Large Datasets (use download_dataset.py to reproduce)
data/IO-VNBD/
data/IO-VNBD-repo/

# Android / Gradle
.gradle/
android_logger/**/build/
android_logger/**/.cxx/
*.apk
*.aab
local.properties
.idea/
*.iml

# OS / Editor
.DS_Store
Thumbs.db
.vscode/

# Derived feature cache: regenerate with scripts/train_real_iovnbd.py --rebuild
outputs/cache_real_features.npz
